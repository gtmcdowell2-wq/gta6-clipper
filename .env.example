# Copy to .env and fill in. Never commit .env (it's in .gitignore).
ANTHROPIC_API_KEY=
REVIEW_PIN=
# YouTube: the OAuth client file you downloaded from Google Auth Platform > Clients (Desktop app)
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram: account ID and a long-lived token from a Facebook Login for Business app
IG_USER_ID=
IG_ACCESS_TOKEN=
# Phone alerts (optional, free). ntfy: install the ntfy app, subscribe to a long random topic name, put it here.
NTFY_TOPIC=
# Discord (optional): Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
